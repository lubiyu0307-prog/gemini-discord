# Local development environment example.
# Run `npm run setup` to automatically generate .gemini-discord/config.json.

# ── REQUIRED ──────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_bot_token_here
# Boss Discord User ID: Stable numeric Discord user ID for full bridge authority.
DISCORD_BOSS_USER_ID=000000000000000000
DISCORD_SERVER_ID=your_discord_server_id_here

# ── OPTIONAL TARGETS ──────────────────────────────────────────────
# Primary channel for the daemon to send its initial "Online" notification.
DISCORD_CHANNEL_ID=
DISCORD_ADMIN_ID=

# ── ADVANCED ──────────────────────────────────────────────────────
# Owner IDs: Legacy routing list, auto-derived from Boss User ID when absent.
# Does NOT grant Boss authority.
DISCORD_OWNER_IDS=
# Enable Guests: Set to true to allow non-boss users to interact with the bot.
# Defaults to false.
DISCORD_ENABLE_GUESTS=false
# Guest Attachments: Set to true to allow guests to submit supported Discord attachments for inspection.
# Defaults to false. Boss attachment processing is always allowed.
DISCORD_ENABLE_GUEST_ATTACHMENTS=false

# ── ALLOWLISTS ────────────────────────────────────────────────────
# Allowed Channels: Leave blank to allow all channels in DISCORD_SERVER_ID.
DISCORD_ALLOWED_CHANNEL_IDS=
# Allowed Users: Comma-separated human allowlist. These users are allowed even when guests are disabled.
DISCORD_ALLOWED_USER_IDS=
# Peer Bot Allowlist: Add IDs of other bots allowed to trigger this agent.
DISCORD_ALLOWED_AGENT_IDS=

# ── INTERNAL (Auto-generated) ─────────────────────────────────────
DAEMON_API_TOKEN=

# ── ENGINE DEFAULTS ───────────────────────────────────────────────
DAEMON_PORT=18790
GEMINI_PATH=gemini
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GEMINI_API_KEY=
# Vertex AI auth is also supported by Gemini CLI when these are set.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_API_KEY=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=

GEMINI_TIMEOUT_MS=900000
GEMINI_MAX_CONCURRENT=3
CONVERSATION_HISTORY_LENGTH=30
PROMPT_HISTORY_MAX_MESSAGES=12
PROMPT_HISTORY_MAX_CHARS=6000
STREAMING=true
QUEUE_MAX_DEPTH=20
ENABLE_DMS=true
REQUIRE_MENTION=true
RESPOND_TO_REPLIES=false
# Discord memory isolation: use channel unless you intentionally want one shared transcript.
# Valid values: channel, global. Invalid values fall back to channel.
MEMORY_SCOPE=channel
AUTO_START_DAEMON=true
USE_GEMINI_CLI_SESSIONS=true
GEMINI_SESSION_BINDING_SCOPE=channel
CLI_IDLE_TIMEOUT_MS=300000
